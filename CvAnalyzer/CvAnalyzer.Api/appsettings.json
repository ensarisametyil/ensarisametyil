{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "FileStorage": {
    "RootPath": "../storage/cv-uploads"
  },
  "AI": {
    "Provider": "Anthropic",
    "Model": "claude-opus-5",
    "ApiKey": "",
    "MaxTokens": 4000,
    "MaxInputCharacters": 20000,
    "TimeoutSeconds": 60
  },
  "Jwt": {
    "Issuer": "CvAnalyzer.Api",
    "Audience": "CvAnalyzer.Web",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Plans": {
    "FreeMonthlyAnalysisLimit": 2,
    "PremiumMonthlyAnalysisLimit": null,
    "PremiumMonthlyPriceUsd": 10.00
  },
  "Iyzico": {
    "ApiKey": "",
    "SecretKey": "",
    "BaseUrl": "https://sandbox-api.iyzipay.com",
    "PremiumPricingPlanReferenceCode": "",
    "CallbackUrl": "http://localhost:5285/api/billing/checkout/callback",
    "FrontendResultUrl": "http://localhost:5173/premium/result"
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Analyze": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Checkout": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Contact": { "PermitLimit": 10, "WindowSeconds": 60 },
    "PasswordReset": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Account": { "PermitLimit": 20, "WindowSeconds": 60 }
  }
}
