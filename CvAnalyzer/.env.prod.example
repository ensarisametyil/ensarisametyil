# Template for docker-compose.prod.yml. Copy to .env.prod, fill in real values, and NEVER commit
# that file (.gitignore already excludes .env* except this .example one).
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# See docs/deployment.md for what each of these means and how to get them.

# ---- Required — the app refuses to start without these ----
CONNECTION_STRING=Host=your-db-host;Port=5432;Database=cvanalyzer;Username=cvora;Password=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
FRONTEND_ORIGIN=https://app.yourdomain.com
BACKEND_ORIGIN=https://api.yourdomain.com

# ---- Set to true ONLY if a reverse proxy/load balancer you control sits in front of the backend
# and the backend container is never directly reachable from the public internet otherwise (see
# the ReverseProxy comment in Program.cs and docs/deployment.md) ----
TRUST_FORWARDED_HEADERS=false

# ---- Optional — omit and the corresponding feature safely returns 503/no-op instead of crashing ----
AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_PRICING_PLAN_REFERENCE_CODE=
IYZICO_CALLBACK_URL=https://api.yourdomain.com/api/billing/checkout/callback
IYZICO_FRONTEND_RESULT_URL=https://app.yourdomain.com/premium/result
ADMIN_BOOTSTRAP_EMAIL=

# ---- Host port mapping (change only if 8080/8081 already in use on the host) ----
BACKEND_PORT=8080
FRONTEND_PORT=8081
