# Bu dosyayı kopyalayıp ".env" adıyla kaydedin ve değerleri kendinize göre
# doldurun. ".env" dosyası git'e eklenmez (bkz. .gitignore) — gerçek
# şifreleri/anahtarları asla kod içine yazmayın veya commit etmeyin.

# --- Veritabanı (zorunlu) --------------------------------------------------
# Vercel Postgres: Vercel Dashboard → Storage → Postgres → Connect to Project
# adımını izlediğinizde bu değişkeni otomatik olarak ayarlar.
# Yerel geliştirme için: postgres://kullanici:sifre@localhost:5432/veritabani
POSTGRES_URL=

# --- Oturum imzalama anahtarı (zorunlu) ------------------------------------
# Rastgele, uzun ve tahmin edilemez bir metin olmalı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Yönetici girişi (zorunlu) ----------------------------------------------
# Kullanıcı adınızı doğrudan yazın; şifreyi ASLA düz metin olarak yazmayın —
# önce bcrypt ile hash'leyin:
#   node -e "console.log(require('bcryptjs').hashSync('SIFRENIZ', 10))"
# çıkan değeri ADMIN_PASSWORD_HASH'e yapıştırın.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Görsel depolama (önerilir, opsiyonel) ---------------------------------
# Vercel Blob: Vercel Dashboard → Storage → Blob → Connect to Project adımını
# izlediğinizde bu değişkeni otomatik olarak ayarlar. Tanımlı değilse,
# yüklenen görseller yerel "public/uploads/" klasörüne kaydedilir — bu SADECE
# yerel geliştirme için uygundur; Vercel'in production ortamında dosya
# sistemi kalıcı olmadığı için görseller kaybolur. Production'da bu değişken
# MUTLAKA tanımlı olmalıdır.
BLOB_READ_WRITE_TOKEN=
